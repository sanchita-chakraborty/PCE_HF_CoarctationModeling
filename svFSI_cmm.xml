<?xml version="1.0" encoding="UTF-8"?>
<svMultiPhysicsFile version="0.1">

  <GeneralSimulationParameters>
    <Continue_previous_simulation>0</Continue_previous_simulation>
    <Number_of_spatial_dimensions>3</Number_of_spatial_dimensions>
    <Number_of_time_steps>4000</Number_of_time_steps>
    <Time_step_size>0.001</Time_step_size>
    <Spectral_radius_of_infinite_time_step>0.5</Spectral_radius_of_infinite_time_step>
    <Searched_file_name_to_trigger_stop>STOP_SIM</Searched_file_name_to_trigger_stop>

    <Save_results_to_VTK_format>1</Save_results_to_VTK_format>
    <Name_prefix_of_saved_VTK_files>result</Name_prefix_of_saved_VTK_files>
    <Increment_in_saving_VTK_files>20</Increment_in_saving_VTK_files>
    <Start_saving_after_time_step>1</Start_saving_after_time_step>
    <Increment_in_saving_restart_files>3000</Increment_in_saving_restart_files>

    <Verbose>1</Verbose>
    <Warning>1</Warning>
    <Debug>1</Debug>
    
    
  </GeneralSimulationParameters>

  <!-- fluid mesh is now named “msh” so SV uses domain 0 implicitly -->
  <Add_mesh name="msh">

    <Mesh_file_path>pulsatile_defwall_v2/mesh-complete/mesh-complete.mesh.vtu</Mesh_file_path>

    <Add_face name="aorta_inlet">
      <Face_file_path>pulsatile_defwall_v2/mesh-complete/mesh-surfaces/cap_aorta.vtp</Face_file_path>
    </Add_face>

    <Add_face name="aorta_outlet">
      <Face_file_path>pulsatile_defwall_v2/mesh-complete/mesh-surfaces/cap_aorta_2.vtp</Face_file_path>
    </Add_face>

    <Add_face name="cap_bct">
      <Face_file_path>pulsatile_defwall_v2/mesh-complete/mesh-surfaces/cap_bct.vtp</Face_file_path>
    </Add_face>

    <Add_face name="cap_left_carotid">
      <Face_file_path>pulsatile_defwall_v2/mesh-complete/mesh-surfaces/cap_left_carotid.vtp</Face_file_path>
    </Add_face>

    <Add_face name="cap_left_subclavian">
      <Face_file_path>pulsatile_defwall_v2/mesh-complete/mesh-surfaces/cap_left_subclavian.vtp</Face_file_path>
    </Add_face>

    <Add_face name="wall">
      <Face_file_path>pulsatile_defwall_v2/mesh-complete/walls_combined.vtp</Face_file_path>
    </Add_face>
    
    <!-- Initial velocities -->
<!--     <Initial_velocities_file_path> ../1-rigid-solution/result_900.vtu </Initial_velocities_file_path>
    <Initial_pressures_file_path> ../1-rigid-solution/result_900.vtu </Initial_pressures_file_path>
 -->
  </Add_mesh>


<Add_equation type="CMM" > 
   <Coupled> true </Coupled>   
   <Min_iterations> 3 </Min_iterations>  
   <Max_iterations> 100 </Max_iterations>
   <Tolerance> 1e-3 </Tolerance>

   <Fluid_density> 1.06 </Fluid_density>
   
   <Viscosity model="Constant" >
      <Value> 0.04 </Value>
   </Viscosity>

   <Solid_density> 1.0 </Solid_density>
   <Poisson_ratio> 0.4 </Poisson_ratio>
   <Shell_thickness> 0.2 </Shell_thickness>
   <Elasticity_modulus> 4000000.0 </Elasticity_modulus>   
    
   <Output type="Spatial">
      <Displacement> true </Displacement>
      <Stress> true </Stress>
      <Velocity> true </Velocity>
      <Pressure> true </Pressure>
      <Traction> true </Traction>
      <WSS> true </WSS>
   </Output>

   <LS type="GMRES" >
     <Linear_algebra type="fsils" >
       <Preconditioner> fsils </Preconditioner>
     </Linear_algebra>
     <Max_iterations> 100 </Max_iterations>
     <Tolerance> 1e-2 </Tolerance>
   </LS>

    <Add_BC name="aorta_inlet">
      <Type>Dir</Type>
      <Time_dependence>Unsteady</Time_dependence>
      <Temporal_values_file_path>inflow.flow</Temporal_values_file_path>
      <Profile>Flat</Profile>
      <Impose_flux>true</Impose_flux>
    </Add_BC>

    <Add_BC name="aorta_outlet">
      <Type>Neu</Type>
      <Time_dependence>RCR</Time_dependence>
      <RCR_values>
        <Capacitance>0.0005856519433119408</Capacitance>
        <Proximal_resistance>156.11321372405104</Proximal_resistance>
        <Distal_resistance>1795.3019578265869</Distal_resistance>
        <Distal_pressure>0</Distal_pressure>
        <Initial_pressure>0</Initial_pressure>
      </RCR_values>
    </Add_BC>

    <Add_BC name="cap_bct">
      <Type>Neu</Type>
      <Time_dependence>RCR</Time_dependence>
      <RCR_values>
        <Capacitance>0.00034019283999696924</Capacitance>
        <Proximal_resistance>268.75347228053755</Proximal_resistance>
        <Distal_resistance>3090.664931226182</Distal_resistance>
        <Distal_pressure>0</Distal_pressure>
        <Initial_pressure>0</Initial_pressure>
      </RCR_values>
    </Add_BC>

    <Add_BC name="cap_left_carotid">
      <Type>Neu</Type>
      <Time_dependence>RCR</Time_dependence>
      <RCR_values>
        <Capacitance>0.00011193812096268461</Capacitance>
        <Proximal_resistance>816.7727509437202</Proximal_resistance>
        <Distal_resistance>9392.886635852781</Distal_resistance>
        <Distal_pressure>0</Distal_pressure>
        <Initial_pressure>0</Initial_pressure>
      </RCR_values>
    </Add_BC>

    <Add_BC name="cap_left_subclavian">
      <Type>Neu</Type>
      <Time_dependence>RCR</Time_dependence>
      <RCR_values>
        <Capacitance>0.00016221709572840544</Capacitance>
        <Proximal_resistance>563.6151145699072</Proximal_resistance>
        <Distal_resistance>6481.573817553933</Distal_resistance>
        <Distal_pressure>0</Distal_pressure>
        <Initial_pressure>0</Initial_pressure>
      </RCR_values>
    </Add_BC>

    <Add_BC name="wall" > 
      <Type> CMM </Type> 
      <Initial_displacements_file_path>inflate_lumen.vtu</Initial_displacements_file_path>
    </Add_BC>
    
    <Output type="B_INT" >
      <Pressure> true </Pressure>
      <Velocity> true </Velocity>
    </Output>

</Add_equation>


